[TEMPLATE]
# Copy to .env and fill in. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Admin seed account
# - ADMIN_EMAIL: email for the admin account.
# - ADMIN_PASSWORD: leave BLANK to generate a strong random one-time password
#   (printed to the server log on first boot). If SET, it is authoritative and
#   re-asserted on every boot — set this in production (e.g. Vercel env vars).
ADMIN_EMAIL=admin@tpclogistics.com
ADMIN_PASSWORD=

API_PORT=5000

# Optional: send real emails via Resend instead of the console fallback
# RESEND_API_KEY=
# RESEND_FROM=TPC Logistics <onboarding@resend.dev>
# SITE_URL=http://localhost:5173

# Set to "true" behind HTTPS
# COOKIE_SECURE=true
